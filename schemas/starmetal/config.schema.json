    "SupplyChainConfig": {
      "description": "Optional supply-chain security controls (ADR-0024). When enabled, publishes are gated at ingest:\neach artifact is scanned and denied when a finding exceeds `policies.max_vuln_severity`. Requires\nthe corresponding scanner build feature (e.g. `scanner-osv`); disabled by default.",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "enforce_on_serve": {
          "default": false,
          "description": "Also enforce the vulnerability gate at serve: `get_artifact` consults each artifact's stored\nscan report (scanning on demand and caching it when absent) and refuses to serve a finding\nthat exceeds `policies.max_vuln_severity`. Off by default — ingest gating only.",
          "type": "boolean"
        },
        "osv_endpoint": {
          "default": null,
          "description": "Override the OSV endpoint base URL (defaults to the public `https://api.osv.dev`). Useful for\na self-hosted OSV mirror.",
          "type": ["string", "null"]
        },
        "quarantine": {
          "default": false,
          "description": "Hold a serve-time gate block as a recoverable quarantine record (an operator can promote or\nreject it via the admin API) instead of a terminal deny. Off by default — blocks are hard\ndenials. Only effective with `enforce_on_serve` and a scanner attached.",
          "type": "boolean"
        },
        "recorrelation_interval_secs": {
          "default": 0,
          "description": "Interval in seconds between scheduled re-correlation sweeps. Each sweep re-scans every stored\nscan report against the (refreshed) advisory feed and rewrites it, so an artifact that was\nclean when first scanned is re-evaluated as new advisories land (\"scan once, then monitor\").\n`0` (the default) disables the scheduler. Only effective when a scanner is attached.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "scanner": {
          "$ref": "#/$defs/ScannerKind",
          "default": "osv",
          "description": "The scanner backend to use."
        }
      },
      "type": "object"
    },
