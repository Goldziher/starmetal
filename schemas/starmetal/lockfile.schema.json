{
  "$defs": {
    "Ecosystem": {
      "description": "Supported package ecosystems.",
      "oneOf": [
        {
          "enum": ["pypi", "npm", "cargo", "hex", "maven", "rubygems", "nuget", "pub"],
          "type": "string"
        },
        {
          "const": "go",
          "description": "Go modules (ADR-0023): resolved from an upstream git repository's tags rather than a\npackage-index protocol, served via the GOPROXY HTTP protocol.",
          "type": "string"
        },
        {
          "const": "zig",
          "description": "Zig packages (ADR-0023): like Go, resolved from an upstream git repository's tagged refs\nrather than a package-index protocol — `zig fetch` downloads and client-side-hashes a\nsource tarball, so this ecosystem is served as a git-sourced tarball proxy rather than\nthrough a registry protocol.",
          "type": "string"
        },
        {
          "const": "swift",
          "description": "Swift packages (ADR-0023): like Go and Zig, resolved from an upstream git repository's\ntagged refs rather than a package-index protocol — the Swift Package Registry (SE-0292)\nprotocol is served on top of the repository's tags rather than through a hosted publish\nworkflow.",
          "type": "string"
        }
      ]
    },
    "LockMetadata": {
      "properties": {
        "generated_at": {
          "type": "string"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "starmetal_version": {
          "type": "string"
        }
      },
      "required": ["schema_version", "generated_at", "starmetal_version"],
      "type": "object"
    },
    "LockedArtifact": {
      "properties": {
        "blake3": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "size": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": ["filename", "blake3", "size"],
      "type": "object"
    },
    "LockedPackage": {
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/LockedArtifact"
          },
          "type": "array"
        },
        "ecosystem": {
          "$ref": "#/$defs/Ecosystem"
        },
        "name": {
          "type": "string"
        },
        "pinned": {
          "default": false,
          "type": "boolean"
        },
        "resolved_from": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": ["ecosystem", "name", "version", "artifacts", "resolved_from"],
      "type": "object"
    }
  },
  "$id": "https://schemas.starmetal.local/starmetal/lockfile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Starmetal-owned JSON Schema for starmetal-lock.toml.",
  "properties": {
    "metadata": {
      "$ref": "#/$defs/LockMetadata"
    },
    "packages": {
      "default": [],
      "items": {
        "$ref": "#/$defs/LockedPackage"
      },
      "type": "array"
    }
  },
  "required": ["metadata"],
  "title": "Starmetal Lock File",
  "type": "object",
  "x-starmetal-source": {
    "generated_by": "starmetal-schema-manager",
    "schema_kind": "starmetal-owned-json-schema",
    "source_file": "crates/starmetal-core/src/lockfile.rs",
    "source_ids": ["starmetal-lockfile"],
    "source_kinds": ["starmetal-rust-type"],
    "source_type": "starmetal_core::lockfile::LockFile",
    "validated_by": "crates/starmetal-core/tests/schema_validation.rs"
  }
}
